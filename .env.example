# ==========================================
# WINDY STORAGE - ENVIRONMENT CONFIGURATION
# ==========================================

# Application Port & Env
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
APP_URL=http://localhost:3000

# PostgreSQL Database
POSTGRES_DB=windy_video_db
POSTGRES_USER=windy_user
POSTGRES_PASSWORD=windy_secure_password_2026
POSTGRES_PORT=5432
DATABASE_URL="postgresql://windy_user:windy_secure_password_2026@localhost:5432/windy_video_db?schema=public"

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password_2026

# MinIO Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost/storage
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minio_secure_password_2026
MINIO_RAW_BUCKET=raw-videos
MINIO_HLS_BUCKET=hls-videos
MINIO_REGION=us-east-1

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=meili_master_key_123456

# Worker & Transcoding
TRANSCODE_CONCURRENCY=2
TEMP_STORAGE_DIR=/tmp/windy-transcode
