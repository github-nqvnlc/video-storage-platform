# ==============================================================================
# WINDY STORAGE - Git Ignore Configuration
# ==============================================================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build Outputs & Bundles
dist/
build/
.next/
out/

# Persistent Docker Runtime Data (Quan trọng: Tránh lỗi Permission & lộ dữ liệu)
data/
data/*

# Environment & Secrets (Không commit mật khẩu / token lên Git)
.env
.env.local
.env.*.local

# Temporary Upload & Transcode Folders
/tmp/
/tmp/windy-transcode/
scratch/
temp/

# IDE & Editor Configs
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Logs & Runtime Process
logs/
*.log
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
.nyc_output/

# Prisma generated artifacts (nếu có)
prisma/generated/
